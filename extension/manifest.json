{
  "manifest_version": 3,
  "name": "K2Pass",
  "version": "0.4.0",
  "description": "K2Pass — خزنة باسوردات أوفلاين. افتح ملف الخزنة المشفّر وانسخ أو املأ الباسوردات.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "K2Pass"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "clipboardWrite"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}