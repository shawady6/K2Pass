{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K2Pass",
  "version": "0.4.1",
  "identifier": "com.shawady.k2pass.windows",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "K2Pass", "width": 980, "height": 700, "minWidth": 720, "minHeight": 520, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "windows": { "wix": { "language": "en-US" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
